# Copy to .env and fill in. Never commit .env.

# --- required before any real use ---
HMAC_SECRET=change-me-to-a-long-random-string           # python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_SECRET=change-me-to-another-long-random-string
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=change-me-strong-password
PUBLIC_BASE_URL=http://localhost:8077                     # used in QR codes for the student question box

# --- mode ---
DEMO_MODE=true            # true: unverified demo services shown (tagged), draft content served, seeding allowed
DEMO_STATE=Lagos

# --- LLM (optional; without it answers are the reviewed text verbatim) ---
LLM_PROVIDER=none         # none | anthropic | openai_compat
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true
# ANTHROPIC_API_KEY=      # paid service: only set if Alamz Tech has agreed to the cost
OPENAI_COMPAT_BASE_URL=http://ollama:11434/v1
OPENAI_COMPAT_MODEL=
LLM_COMPOSE_ANSWERS=true
LLM_CRISIS_CLASSIFIER=true

# --- voice (optional; self-hosted OpenAI-compatible audio server, e.g. Whisper / Meta MMS) ---
STT_PROVIDER=none         # none | openai_compat_http
TTS_PROVIDER=none
VOICE_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small
TTS_MODEL=
VOICE_APPROVED_LANGS=     # e.g. en,pcm  ONLY after scripts/eval_voice.py + native-speaker listening
FEATURE_HAUSA=false

# --- retention ---
QUESTION_TTL_HOURS=48
REFERRAL_TTL_DAYS=90
EVENTS_RETENTION_DAYS=365

# --- dashboard ---
DASHBOARD_SAMPLE_BADGE=true
PILOT_START_DATE=

# --- future channels (off) ---
FEATURE_WHATSAPP=false
SIM_ENABLED=false
